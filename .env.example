SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional modern aliases: SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY
# Public application origin used server-side for authentication redirects.
# Production: https://ai-growth-kit.netlify.app
# Local development only: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Server-only bootstrap identity. The first successful sign-in by this exact
# address receives an idempotent, audited platform_admin role assignment.
INITIAL_PLATFORM_ADMIN_EMAIL=
# Temporary V1 access mode. Set false to restore Supabase email/password login.
REVIEW_MODE=false
# UUID of the existing member_app_access row for the ABC Financial Solutions
# review account. This value remains server-side and is never accepted from the browser.
REVIEW_MEMBER_ID=
# Optional signing secret. When omitted, the existing server-only Supabase
# service-role/secret key signs review sessions.
REVIEW_MODE_SECRET=
