SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional modern aliases: SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY
APP_BASE_URL=http://localhost:8888
# Initial platform owner. Configure these as protected Netlify environment values.
# Invite this address through Supabase Authentication; the first successful sign-in
# creates the database-backed super_admin account without storing a password here.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_FIRST_NAME=
PLATFORM_OWNER_LAST_NAME=
