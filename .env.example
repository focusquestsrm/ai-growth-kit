SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional modern aliases: SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY
# Public application origin used server-side for authentication redirects.
# Production: https://ai-growth-kit.netlify.app
# Local development only: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Server-only bootstrap identity. The first successful sign-in by this exact
# address receives an idempotent, audited platform_admin role assignment.
INITIAL_PLATFORM_ADMIN_EMAIL=
